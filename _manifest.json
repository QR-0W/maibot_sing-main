{
  "manifest_version": 2,
  "id": "qr0w.maibot-sing",
  "version": "0.6.1",
  "name": "让麦麦说话和唱歌",
  "description": "受限本地 RVC 翻唱、网易云/QQ 音乐来源搜索、永久音频与单次投递；历史 TTS 暂不支持",
  "author": {
    "name": "QR-0W (derived from xiaocutedog)",
    "url": "https://github.com/QR-0W/maibot_sing-main"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/QR-0W/maibot_sing-main/",
    "issues": "https://github.com/QR-0W/maibot_sing-main/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.2",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    },
    {
      "type": "python_package",
      "name": "cryptography",
      "version_spec": ">=42.0.0"
    },
    {
      "type": "python_package",
      "name": "segno",
      "version_spec": ">=1.6.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.custom",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
